---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../../lib/recommendations';

// Fetch all posts to test against
const allReviews = await getCollection('reviews');
const allComparisons = await getCollection('comparisons');
const allNews = await getCollection('news');

// Combine for comprehensive test (if cross-silo enabled) or test per silo
const allPosts = [...allReviews, ...allComparisons, ...allNews];

// Select a few test subjects (mock posts preferable)
// Select a few test subjects (mock posts preferable)
const testSubjects = [
    allReviews.find(p => p.id.includes('mock-review-1')),
    allReviews.find(p => p.id.includes('mock-review-2')),
    allComparisons.find(p => p.id.includes('mock-comparison-1')),
].filter(Boolean);

---

<Layout title="Recommendation Engine Test">
    <main class="max-w-4xl mx-auto p-8">
        <h1 class="text-3xl font-bold mb-8">Recommendation Engine Visual Test</h1>
        
        {testSubjects.map(subject => {
            const recommendations = getRelatedPosts(subject, allPosts);
            return (
                <section class="mb-12 border p-6 rounded bg-slate-50">
                    <h2 class="text-xl font-bold mb-4">Subject: {subject.data.title}</h2>
                    <div class="mb-4 text-sm text-gray-600">
                        <p>Tags: {subject.data.tags?.join(', ') || 'None'}</p>
                        <p>Category: {subject.data.category}</p>
                    </div>

                    <h3 class="font-bold mb-2">Recommendations (Top 3):</h3>
                    {recommendations.length > 0 ? (
                        <ul class="space-y-2">
                            {recommendations.map(rec => (
                                <li class="p-2 bg-white border rounded flex justify-between">
                                    <span>{rec.data.title}</span>
                                    <span class="text-xs bg-gray-200 px-2 py-1 rounded">
                                        {rec.collection}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    ) : (
                        <p class="text-red-500">No recommendations found.</p>
                    )}
                </section>
            )
        })}
        
        <div class="mt-8 p-4 bg-yellow-100 rounded">
            <strong>Note:</strong> Used {allPosts.length} total posts in the pool.
        </div>
    </main>
</Layout>
