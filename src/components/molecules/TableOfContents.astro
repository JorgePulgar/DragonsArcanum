---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter out h1 and ensure we only have h2 and h3
const toc = headings.filter((h) => h.depth > 1 && h.depth <= 3);
---

{
  toc.length > 0 && (
    <details class="toc-container my-8 bg-copper-100 rounded-lg border border-copper-200 group">
      <summary class="list-none cursor-pointer p-4 flex justify-between items-center md:cursor-default md:pointer-events-none">
        <h2 class="text-xl font-serif font-bold text-copper-900 m-0">Table of Contents</h2>
        <span class="md:hidden text-copper-500 group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <nav class="toc px-4 pb-4">
        <ul class="space-y-2">
          {toc.map((heading) => (
            <li class={`toc-item toc-h${heading.depth} ${heading.depth === 3 ? 'ml-4' : ''}`}>
              <a
                href={`#${heading.slug}`}
                class="text-copper-700 hover:text-tradewind-600 transition-colors duration-200 block py-1"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <script>
      const tocDetails = document.querySelector('.toc-container');
      function handleTocResize() {
        if (!tocDetails) return;
        if (window.innerWidth >= 768) {
          tocDetails.setAttribute('open', '');
        }
      }
      // Run immediately
      handleTocResize();
      // Run on resize
      window.addEventListener('resize', handleTocResize);
    </script>
  )
}
